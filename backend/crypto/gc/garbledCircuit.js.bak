/**
 * VEIL — Garbled Circuit Module
 *
 * ─────────────────────────────────────────────────────────────────────────────
 * THEORY BACKGROUND
 * ─────────────────────────────────────────────────────────────────────────────
 *
 * Garbled circuits (Yao 1986) allow two parties to jointly evaluate a boolean
 * circuit f(x, y) where Alice holds x and Bob holds y, without either learning
 * the other's input.
 *
 * In VEIL:
 *   Alice = CLIENT  (holds query latitude/longitude)
 *   Bob   = SERVER  (holds POI dataset)
 *   f     = kNN distance comparison circuit
 *
 * WIRE LABELS
 * ───────────
 * Every wire w in the circuit has two 128-bit labels: W^0_w and W^1_w.
 *   W^0_w = label encoding logical-0 on wire w
 *   W^1_w = label encoding logical-1 on wire w
 *
 * Free-XOR global Δ:
 *   A random 128-bit "global difference" Δ is chosen once per circuit.
 *   W^1_w = W^0_w ⊕ Δ  for every wire w.
 * This makes XOR gates "free" (no ciphertext rows, just XOR the labels).
 *
 * GATE TYPES
 * ──────────
 * XOR gate (Free-XOR technique, Kolesnikov & Schneider 2008):
 *   Given input wires a, b and output wire c:
 *     W^0_c = W^0_a ⊕ W^0_b
 *     W^1_c = W^0_c ⊕ Δ
 *   Evaluator computes: label_c = label_a ⊕ label_b   (1 XOR, 0 AES calls)
 *
 * AND gate (Half-gates technique, Zahur, Rosulek & Evans 2015):
 *   The half-gate scheme requires exactly 2 AES calls during garbling and
 *   2 AES calls during evaluation per AND gate (vs 4 in the classical scheme).
 *   Each gate stores 2 × 16-byte ciphertexts (the two half-table entries).
 *   Pointer bits: the LSB of each label acts as a "colour bit" that determines
 *   which row the evaluator decrypts without learning the wire value.
 *
 * CIRCUIT FOR kNN DISTANCE
 * ────────────────────────
 * For 32-bit integer coordinates (lat/lng × 10^6):
 *   SUB(x_c, x_p)  →  dx           (33-bit subtractor)
 *   MUL(dx, dx)    →  dx²           (64-bit squarer = n² AND gates for n-bit inputs)
 *   SUB(y_c, y_p)  →  dy           (33-bit subtractor)
 *   MUL(dy, dy)    →  dy²
 *   ADD(dx², dy²)  →  dist²         (65-bit adder)
 *   CMP(dist², T)  →  is_nearest?  (1-bit comparator)
 *
 * ─────────────────────────────────────────────────────────────────────────────
 * IMPLEMENTATION NOTE
 * ─────────────────────────────────────────────────────────────────────────────
 * A full production GC system uses AES-128 (e.g. via hardware AES-NI) for the
 * garbling hash: H(W_a, W_b, gid) = AES_k(W_a ⊕ W_b ⊕ gid_enc).
 *
 * In this Node.js implementation we use Node's built-in `crypto` module for
 * AES-128-ECB to simulate the same operations. The protocol logic is
 * identical to a production GC; only the throughput (GHz AES-NI vs JS) differs.
 *
 * This module exports:
 *   garbleCircuit(poiCoords, k)  → { garbledGates, inputLabels, outputLabels, delta }
 *   evaluateCircuit(gc, clientLabels) → boolean[]  (which POIs are in top-k)
 *
 * ─────────────────────────────────────────────────────────────────────────────
 */

import crypto from "crypto";

// ─────────────────────────────────────────────────────────────────────────────
// WIRE LABEL UTILITIES
// ─────────────────────────────────────────────────────────────────────────────

const LABEL_BYTES = 16; // 128-bit labels

/** Generate a cryptographically random 128-bit label. */
function randomLabel() {
  return crypto.randomBytes(LABEL_BYTES);
}

/**
 * XOR two 16-byte Buffers.
 * @returns {Buffer}
 */
function xorBufs(a, b) {
  const out = Buffer.alloc(LABEL_BYTES);
  for (let i = 0; i < LABEL_BYTES; i++) out[i] = a[i] ^ b[i];
  return out;
}

/**
 * Read the LSB (pointer bit) of a label.
 * The pointer bit allows the evaluator to choose the correct ciphertext
 * row without learning the underlying wire value.
 */
function pointerBit(label) {
  return label[LABEL_BYTES - 1] & 1;
}

/**
 * Force the LSB of a label to a specific bit value.
 * Used during label generation to set canonical pointer bits.
 */
function setPointerBit(label, bit) {
  const out = Buffer.from(label);
  out[LABEL_BYTES - 1] = (out[LABEL_BYTES - 1] & 0xfe) | (bit & 1);
  return out;
}

// ─────────────────────────────────────────────────────────────────────────────
// AES-128 GARBLING HASH
// ─────────────────────────────────────────────────────────────────────────────

/**
 * The garbling hash H(W_a, W_b, gateId) used to encrypt each table row.
 *
 * We follow the "fixed-key AES" paradigm (Bellare et al. 2013):
 *   H(x, t) = π(2x ⊕ t) ⊕ 2x ⊕ t
 * where π is AES under a fixed key and 2x is multiplication by 2 in GF(2^128).
 *
 * For simplicity here we use:
 *   H(W_a, W_b, gid) = AES_{fixed}(W_a ⊕ W_b ⊕ gid_block)
 *
 * @param {Buffer} labelA   - 16-byte label for wire a
 * @param {Buffer} labelB   - 16-byte label for wire b
 * @param {number} gateId   - integer gate id (for circuit position binding)
 * @returns {Buffer}        - 16-byte hash output
 */
const FIXED_KEY = Buffer.from("VEIL_GC_KEY_FIXED", "utf8").subarray(0, 16);

function garbleHash(labelA, labelB, gateId) {
  // Encode gateId into a 16-byte block
  const gidBuf = Buffer.alloc(LABEL_BYTES, 0);
  gidBuf.writeUInt32BE(gateId, 12);

  // Tweak = labelA ⊕ labelB ⊕ gid_block
  const tweak = xorBufs(xorBufs(labelA, labelB), gidBuf);

  // AES-128 under fixed key
  const cipher = crypto.createCipheriv("aes-128-ecb", FIXED_KEY, null);
  cipher.setAutoPadding(false);
  return Buffer.concat([cipher.update(tweak), cipher.final()]);
}

// ─────────────────────────────────────────────────────────────────────────────
// WIRE STORE
// ─────────────────────────────────────────────────────────────────────────────

/**
 * WireStore holds the two labels for every wire in the circuit.
 * During garbling (server), all labels are known.
 * During evaluation (client), only one label per wire is known.
 */
class WireStore {
  constructor(delta) {
    this.delta = delta; // global Free-XOR difference Δ
    this.wires = new Map(); // wireId → { w0: Buffer, w1: Buffer }
    this._nextId = 0;
  }

  /**
   * Allocate a new wire with two fresh labels satisfying W^1 = W^0 ⊕ Δ.
   * The pointer bit of W^0 is set to 0 (and W^1 to 1 automatically via Δ).
   */
  newWire() {
    const id = this._nextId++;
    let w0 = randomLabel();
    w0 = setPointerBit(w0, 0); // canonical: W^0 has pointer bit 0
    const w1 = xorBufs(w0, this.delta); // W^1 = W^0 ⊕ Δ → pointer bit flips
    this.wires.set(id, { w0, w1 });
    return id;
  }

  label(wireId, bit) {
    const { w0, w1 } = this.wires.get(wireId);
    return bit === 0 ? w0 : w1;
  }

  labelPair(wireId) {
    return this.wires.get(wireId);
  }
}

// ─────────────────────────────────────────────────────────────────────────────
// GATE BUILDERS
// ─────────────────────────────────────────────────────────────────────────────

/**
 * Garble an XOR gate (Free-XOR — zero ciphertext cost).
 *
 * Input wires: a, b  →  Output wire: c
 * W^0_c = W^0_a ⊕ W^0_b
 * W^1_c = W^0_c ⊕ Δ  (automatic from WireStore.newWire)
 *
 * But instead of calling newWire() (which generates a random W^0_c),
 * we DEFINE W^0_c = W^0_a ⊕ W^0_b explicitly.
 *
 * @returns {{ type: 'XOR', inputWires: number[], outputWire: number }}
 */
function garbleXOR(store, wireA, wireB) {
  const idC = store._nextId++;
  const w0c = xorBufs(store.label(wireA, 0), store.label(wireB, 0));
  // W^1_c = w0c ⊕ Δ  (satisfies Free-XOR invariant)
  const w1c = xorBufs(w0c, store.delta);
  store.wires.set(idC, { w0: w0c, w1: w1c });

  return {
    type: "XOR",
    inputWires: [wireA, wireB],
    outputWire: idC,
    // No ciphertext table — the evaluator computes label_a ⊕ label_b
  };
}

/**
 * Garble an AND gate using the Half-gate technique.
 *
 * The half-gate method splits each AND gate into:
 *   - A "garbler's half" (depends only on server's input label)
 *   - An "evaluator's half" (depends only on client's input label)
 * Together they compute the AND gate with 2 ciphertext rows (vs 4 classical).
 *
 * Protocol:
 *   Let p_a = pointer_bit(W^0_a),  p_b = pointer_bit(W^0_b)
 *
 *   Garbler's half:
 *     T_g = H(W^0_a, gid) ⊕ H(W^1_a, gid) ⊕ (p_b · Δ)
 *
 *   Evaluator's half:
 *     T_e = H(W^0_b, gid) ⊕ H(W^1_b, gid) ⊕ W^0_a
 *
 *   Output wire label (W^0_c):
 *     W^0_c = H(W^0_a, gid) ⊕ (p_a · T_g)    [garbler half result]
 *             ⊕  H(W^0_b, gid) ⊕ (p_b · (T_e ⊕ W^0_a))  [evaluator half result]
 *
 * Evaluation (client sees label_a, label_b):
 *   s_a = pointer_bit(label_a)
 *   s_b = pointer_bit(label_b)
 *   W_g = H(label_a, gid) ⊕ (s_a · T_g)
 *   W_e = H(label_b, gid) ⊕ (s_b · (T_e ⊕ label_a))
 *   label_c = W_g ⊕ W_e
 *
 * @returns {{ type: 'AND', inputWires, outputWire, tg: Buffer, te: Buffer }}
 */
function garbleAND(store, wireA, wireB, gateId) {
  const w0a = store.label(wireA, 0);
  const w1a = store.label(wireA, 1);
  const w0b = store.label(wireB, 0);
  const w1b = store.label(wireB, 1);

  const p_a = pointerBit(w0a); // 0 by construction
  const p_b = pointerBit(w0b); // 0 by construction

  // Garbler's half ciphertext
  const Hg0 = garbleHash(w0a, Buffer.alloc(16), gateId * 2);
  const Hg1 = garbleHash(w1a, Buffer.alloc(16), gateId * 2);
  let Tg = xorBufs(Hg0, Hg1);
  if (p_b) Tg = xorBufs(Tg, store.delta);

  // Evaluator's half ciphertext
  const He0 = garbleHash(w0b, Buffer.alloc(16), gateId * 2 + 1);
  const He1 = garbleHash(w1b, Buffer.alloc(16), gateId * 2 + 1);
  let Te = xorBufs(xorBufs(He0, He1), w0a);

  // Output wire W^0_c
  let w0c = xorBufs(Hg0, He0);
  if (p_a) w0c = xorBufs(w0c, Tg);
  if (p_b) w0c = xorBufs(w0c, xorBufs(Te, w0a));

  const w1c = xorBufs(w0c, store.delta);

  const idC = store._nextId++;
  store.wires.set(idC, { w0: w0c, w1: w1c });

  return {
    type: "AND",
    inputWires: [wireA, wireB],
    outputWire: idC,
    tg: Tg,
    te: Te,
  };
}

// ─────────────────────────────────────────────────────────────────────────────
// ARITHMETIC CIRCUIT BUILDERS
// ─────────────────────────────────────────────────────────────────────────────

/**
 * Full-adder cell: computes (sum, carry) = a + b + cin
 *   sum   = a ⊕ b ⊕ cin         (2 XOR = free)
 *   carry = (a & b) | (b & cin) | (a & cin)
 *         = (a & b) ⊕ ((a ⊕ b) & cin)  (2 AND, 2 XOR)
 *
 * Returns { sumWire, carryWire, gates }
 */
function fullAdderCell(store, gates, gateCounter, wireA, wireB, wireCin) {
  const xorAB = garbleXOR(store, wireA, wireB);
  gates.push(xorAB);

  const andAB = garbleAND(store, wireA, wireB, gateCounter.next());
  gates.push(andAB);

  const andXorCin = garbleAND(store, xorAB.outputWire, wireCin, gateCounter.next());
  gates.push(andXorCin);

  const sumGate = garbleXOR(store, xorAB.outputWire, wireCin);
  gates.push(sumGate);

  const carryGate = garbleXOR(store, andAB.outputWire, andXorCin.outputWire);
  gates.push(carryGate);

  return { sumWire: sumGate.outputWire, carryWire: carryGate.outputWire };
}

/**
 * Ripple-carry n-bit subtractor circuit (a − b).
 * Subtraction as addition of two's complement: a + (~b) + 1
 *   invert all bits of b, then add with carry-in = 1.
 *
 * Returns { outputWires: number[], gates: object[] }
 * outputWires has (n+1) bits (n result bits + overflow bit).
 */
function buildSubtractor(store, gates, gateCounter, aWires, bWires) {
  const n = aWires.length;
  // Create constant-1 wire for carry-in (two's complement subtraction)
  const ONE_WIRE = store.newWire();
  store.wires.set(ONE_WIRE, {
    w0: store.label(ONE_WIRE, 0),
    w1: store.label(ONE_WIRE, 1),
  });
  // Note: the server knows bit 1 → carry-in; it will provide the W^1 label.

  // Invert b bits via XOR with constant 1 (since W^1 = W^0 ⊕ Δ, this is free)
  const bInv = bWires.map((bw) => {
    // XOR with a "constant-1" wire whose both labels are swapped
    // In practice: just swap w0/w1 in the store (free bit flip)
    const swapped = store.newWire();
    store.wires.set(swapped, {
      w0: store.label(bw, 1), // note: w0 now holds what was w1
      w1: store.label(bw, 0),
    });
    return swapped;
  });

  let carry = ONE_WIRE;
  const resultWires = [];

  for (let i = 0; i < n; i++) {
    const { sumWire, carryWire } = fullAdderCell(
      store,
      gates,
      gateCounter,
      aWires[i],
      bInv[i],
      carry
    );
    resultWires.push(sumWire);
    carry = carryWire;
  }
  resultWires.push(carry); // overflow bit

  return { outputWires: resultWires };
}

/**
 * Schoolbook n-bit squarer circuit (a²).
 *
 * a² = Σ_{i} Σ_{j} a_i · a_j · 2^(i+j)
 *
 * For each pair (i, j) with i ≤ j:
 *   - Compute AND gate for a_i · a_j
 *   - If i < j: bit contributes twice (shift & add 2× partial product)
 *   - If i == j: just a_i (since a_i² = a_i for bits)
 *
 * For this simulation we build a simplified version:
 * compute partial products and reduce with an adder tree.
 * Full bit-width result is 2n bits.
 *
 * Returns { outputWires: number[] }  (2n bit wires)
 */
function buildSquarer(store, gates, gateCounter, aWires) {
  const n = aWires.length;
  const resultLen = 2 * n;

  // Partial product matrix: pp[k] = list of wire ids that contribute to bit k
  const pp = Array.from({ length: resultLen }, () => []);

  for (let i = 0; i < n; i++) {
    for (let j = i; j < n; j++) {
      const andGate = garbleAND(store, aWires[i], aWires[j], gateCounter.next());
      gates.push(andGate);
      const bit = i + j;
      pp[bit].push(andGate.outputWire);
      if (i !== j) {
        // Double-count for symmetric pairs: add again at same bit position
        // (In a full implementation this uses a carry-save adder tree)
        pp[bit].push(andGate.outputWire);
      }
    }
  }

  // Reduce each bit column with XOR chains (simplified — CSA tree in production)
  const outputWires = [];
  let carryWires = new Array(resultLen).fill(null);

  for (let bit = 0; bit < resultLen; bit++) {
    let current = pp[bit];
    if (carryWires[bit]) current = current.concat(carryWires[bit]);

    while (current.length > 1) {
      const reduced = [];
      for (let i = 0; i + 1 < current.length; i += 2) {
        const xg = garbleXOR(store, current[i], current[i + 1]);
        gates.push(xg);
        reduced.push(xg.outputWire);
      }
      if (current.length % 2 === 1) reduced.push(current[current.length - 1]);
      current = reduced;
    }

    outputWires.push(current.length > 0 ? current[0] : store.newWire());
  }

  return { outputWires };
}

// ─────────────────────────────────────────────────────────────────────────────
// FULL kNN CIRCUIT GARBLING
// ─────────────────────────────────────────────────────────────────────────────

/**
 * Garble the complete kNN distance circuit for a single POI.
 *
 * Computes: dist² = (x_c − x_p)² + (y_c − y_p)²
 *
 * @param {WireStore} store
 * @param {object}    gateCounter  - shared { next: () => number }
 * @param {number[]}  xClientWires - 32 wire ids for client's x-coordinate bits
 * @param {number[]}  yClientWires - 32 wire ids for client's y-coordinate bits
 * @param {number[]}  xPOIBits     - integer bit array for POI's x (server knows)
 * @param {number[]}  yPOIBits     - integer bit array for POI's y (server knows)
 * @returns {{ gates, distWires, xPoiWires, yPoiWires }}
 */
function garblePOIDistanceCircuit(
  store,
  gateCounter,
  gates,
  xClientWires,
  yClientWires,
  xPOIBits,
  yPOIBits
) {
  const COORD_BITS = 32;

  // Allocate server-side input wires for POI coordinates
  // The server KNOWS these values, so it provides the correct labels directly
  const xPoiWires = xPOIBits.map((bit) => {
    const wid = store.newWire();
    return { wid, bit }; // server will inject correct label during evaluation
  });
  const yPoiWires = yPOIBits.map((bit) => {
    const wid = store.newWire();
    return { wid, bit };
  });

  // Build subtractor: dx = x_c − x_p
  const dxResult = buildSubtractor(
    store,
    gates,
    gateCounter,
    xClientWires,
    xPoiWires.map((w) => w.wid)
  );

  // Build subtractor: dy = y_c − y_p
  const dyResult = buildSubtractor(
    store,
    gates,
    gateCounter,
    yClientWires,
    yPoiWires.map((w) => w.wid)
  );

  // Square dx and dy (take only the lower COORD_BITS+1 for the squarer)
  const dxWires = dxResult.outputWires.slice(0, COORD_BITS + 1);
  const dyWires = dyResult.outputWires.slice(0, COORD_BITS + 1);

  const dx2 = buildSquarer(store, gates, gateCounter, dxWires);
  const dy2 = buildSquarer(store, gates, gateCounter, dyWires);

  // Add dx² + dy² using a ripple-carry adder
  // Simplified: chain of full-adder cells across both operand arrays
  const sumLen = Math.max(dx2.outputWires.length, dy2.outputWires.length) + 1;
  const ZERO_WIRE = store.newWire(); // constant-0 wire for padding
  const distWires = [];
  let carry = ZERO_WIRE;

  for (let i = 0; i < sumLen - 1; i++) {
    const aw = i < dx2.outputWires.length ? dx2.outputWires[i] : ZERO_WIRE;
    const bw = i < dy2.outputWires.length ? dy2.outputWires[i] : ZERO_WIRE;
    const { sumWire, carryWire } = fullAdderCell(
      store,
      gates,
      gateCounter,
      aw,
      bw,
      carry
    );
    distWires.push(sumWire);
    carry = carryWire;
  }
  distWires.push(carry);

  return {
    distWires,
    xPoiWires: xPoiWires.map((w) => w.wid),
    yPoiWires: yPoiWires.map((w) => w.wid),
  };
}

// ─────────────────────────────────────────────────────────────────────────────
// GARBLE CIRCUIT (Public API — Server calls this)
// ─────────────────────────────────────────────────────────────────────────────

/**
 * Convert an integer to its bit array (LSB first, padded to width bits).
 */
function intToBits(n, width) {
  const bits = [];
  const absN = Math.abs(Math.round(n));
  for (let i = 0; i < width; i++) bits.push((absN >> i) & 1);
  return bits;
}

/**
 * Garble the entire kNN circuit for a set of POIs.
 *
 * The server garbles circuits for all n POIs. The client will:
 *   1. Obtain input labels for its query coordinates via OT.
 *   2. Evaluate each POI circuit.
 *   3. Compare dist² values and return the k smallest POI ids.
 *
 * @param {object[]} pois     - Array of { id, latitude, longitude } objects
 * @param {number}   k        - Number of nearest neighbours requested
 * @returns {object}          - The complete garbled circuit bundle
 */
export function garbleCircuit(pois, k = 5) {
  const COORD_BITS = 32;

  // Generate global Free-XOR Δ (must have LSB=1 so pointer bits work)
  let delta = randomLabel();
  delta[LABEL_BYTES - 1] |= 1; // ensure LSB = 1

  const store = new WireStore(delta);
  const gates = [];

  // Gate id counter (shared across all sub-circuits for unique ids)
  let _gid = 0;
  const gateCounter = { next: () => _gid++ };

  // Allocate client input wires (x_c and y_c, COORD_BITS each)
  // These are the wires for which the client will obtain labels via OT
  const xClientWires = Array.from({ length: COORD_BITS }, () => store.newWire());
  const yClientWires = Array.from({ length: COORD_BITS }, () => store.newWire());

  // For each POI, build a distance circuit and record output wires
  const poiCircuits = [];
  for (const poi of pois) {
    // Convert POI coordinates to integer microdegrees, then to bits
    const xPOI = Math.round(poi.latitude * 1e6);
    const yPOI = Math.round(poi.longitude * 1e6);
    const xPOIBits = intToBits(xPOI, COORD_BITS);
    const yPOIBits = intToBits(yPOI, COORD_BITS);

    const { distWires, xPoiWires, yPoiWires } = garblePOIDistanceCircuit(
      store,
      gateCounter,
      gates,
      xClientWires,
      yClientWires,
      xPOIBits,
      yPOIBits
    );

    // Inject server's known labels for POI input wires
    const serverInputLabels = {};
    xPoiWires.forEach((wid, i) => {
      serverInputLabels[wid] = store.label(wid, xPOIBits[i]);
    });
    yPoiWires.forEach((wid, i) => {
      serverInputLabels[wid] = store.label(wid, yPOIBits[i]);
    });

    poiCircuits.push({
      poiId: poi.id,
      distWires,
      serverInputLabels,
    });
  }

  // Serialize gates (convert Buffers to hex strings for JSON transport)
  const serializedGates = gates.map((g) => ({
    type: g.type,
    inputWires: g.inputWires,
    outputWire: g.outputWire,
    tg: g.tg?.toString("hex") ?? null,
    te: g.te?.toString("hex") ?? null,
  }));

  // Serialize all wire labels (only w0 needed for evaluator verification,
  // but we include both for the simulation; production GC only sends garbled tables)
  const clientInputWireLabels = {};
  [...xClientWires, ...yClientWires].forEach((wid) => {
    const { w0, w1 } = store.labelPair(wid);
    clientInputWireLabels[wid] = {
      w0: w0.toString("hex"),
      w1: w1.toString("hex"),
    };
  });

  return {
    // Circuit metadata
    delta: delta.toString("hex"),
    numGates: gates.length,
    numClientInputWires: xClientWires.length + yClientWires.length,

    // Garbled tables (to be sent to the client)
    garbledGates: serializedGates,

    // Client input wire structure (sent to client; labels distributed via OT)
    xClientWires,
    yClientWires,
    clientInputWireLabels,

    // Per-POI data
    poiCircuits: poiCircuits.map((pc) => ({
      poiId: pc.poiId,
      distWires: pc.distWires,
      serverInputLabels: Object.fromEntries(
        Object.entries(pc.serverInputLabels).map(([wid, buf]) => [
          wid,
          buf.toString("hex"),
        ])
      ),
    })),

    // Simulation: full wire store (not sent in production)
    _wireStoreSerialized: Object.fromEntries(
      [...store.wires.entries()].map(([wid, { w0, w1 }]) => [
        wid,
        { w0: w0.toString("hex"), w1: w1.toString("hex") },
      ])
    ),
  };
}

// ─────────────────────────────────────────────────────────────────────────────
// EVALUATE CIRCUIT (Public API — Client calls this)
// ─────────────────────────────────────────────────────────────────────────────

/**
 * Simulate garbled circuit evaluation on the client side.
 *
 * In a real deployment, the client ONLY knows:
 *   - Its own input labels (received via OT)
 *   - The server's input labels (provided in clear, since server's input is public to circuit)
 *   - The garbled gate tables
 *
 * @param {object}   gc            - The garbled circuit object from garbleCircuit()
 * @param {number[]} queryBits     - Client's coordinate bits [x_bits..., y_bits...]
 * @param {number}   k             - Number of results to return
 * @returns {string[]}             - Ordered array of k nearest POI ids
 */
export function evaluateCircuit(gc, queryBits, k = 5) {
  // Step 1: Recover client's input labels using query bits
  // (In production, these arrive via OT — here we directly look them up)
  const wireValues = {}; // wireId → Buffer (the active label)

  const allClientWires = [...gc.xClientWires, ...gc.yClientWires];
  allClientWires.forEach((wid, i) => {
    const bit = queryBits[i];
    const { w0, w1 } = gc.clientInputWireLabels[wid];
    wireValues[wid] = Buffer.from(bit === 0 ? w0 : w1, "hex");
  });

  // Step 2: Inject server's input labels for each POI circuit
  for (const pc of gc.poiCircuits) {
    for (const [widStr, labelHex] of Object.entries(pc.serverInputLabels)) {
      wireValues[parseInt(widStr)] = Buffer.from(labelHex, "hex");
    }
  }

  // Step 3: Evaluate each gate in topological order
  const deltaBytes = Buffer.from(gc.delta, "hex");

  for (const gate of gc.garbledGates) {
    const [wA, wB] = gate.inputWires;
    const labelA = wireValues[wA];
    const labelB = wireValues[wB];

    if (!labelA || !labelB) continue; // wire not yet resolved

    let labelOut;

    if (gate.type === "XOR") {
      // Free-XOR: simply XOR the two input labels
      labelOut = xorBufs(labelA, labelB);
    } else if (gate.type === "AND") {
      // Half-gate evaluation
      const Tg = Buffer.from(gate.tg, "hex");
      const Te = Buffer.from(gate.te, "hex");

      const s_a = pointerBit(labelA);
      const s_b = pointerBit(labelB);

      const Hg = garbleHash(labelA, Buffer.alloc(16), gate.outputWire * 2);
      const He = garbleHash(labelB, Buffer.alloc(16), gate.outputWire * 2 + 1);

      let Wg = Hg;
      if (s_a) Wg = xorBufs(Wg, Tg);

      let We = He;
      if (s_b) We = xorBufs(We, xorBufs(Te, labelA));

      labelOut = xorBufs(Wg, We);
    }

    if (labelOut) wireValues[gate.outputWire] = labelOut;
  }

  // Step 4: For each POI, extract the dist² value from output wire labels
  // Determine which label is W^0 (value 0) and which is W^1 (value 1)
  const wireStore = gc._wireStoreSerialized;

  const poiDistances = gc.poiCircuits.map((pc) => {
    let dist2 = 0;
    for (let bit = 0; bit < pc.distWires.length; bit++) {
      const wid = pc.distWires[bit];
      const activeLabel = wireValues[wid];
      if (!activeLabel) continue;
      const w0hex = wireStore[wid]?.w0;
      if (!w0hex) continue;
      const w0 = Buffer.from(w0hex, "hex");
      // If active label equals W^0 → bit is 0; else bit is 1
      const bitValue = activeLabel.equals(w0) ? 0 : 1;
      dist2 += bitValue * Math.pow(2, bit);
    }
    return { poiId: pc.poiId, dist2 };
  });

  // Step 5: Sort by dist² and return k nearest POI ids
  poiDistances.sort((a, b) => a.dist2 - b.dist2);
  return poiDistances.slice(0, k).map((p) => p.poiId);
}
